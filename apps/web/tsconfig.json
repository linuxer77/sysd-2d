{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false, "declaration": false, "declarationMap": false, "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "module": "ESNext", "moduleResolution": "Bundler", "customConditions": ["development"],
    "jsx": "react-jsx", "allowImportingTsExtensions": false, "verbatimModuleSyntax": true,
    "noUnusedLocals": false
  },
  "include": ["src", "vite.config.ts"]
}
